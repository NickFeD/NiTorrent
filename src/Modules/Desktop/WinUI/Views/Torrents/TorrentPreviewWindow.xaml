<?xml version="1.0" encoding="utf-8"?>
<winuiEx:WindowEx
    x:Class="NiTorrent.App.Views.Torrents.TorrentPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tree="using:NiTorrent.Presentation.Features.Torrents.Tree"
    xmlns:winuiEx="using:WinUIEx"
    x:Name="RootWindow"
    MinWidth="560" MinHeight="520" Width="720" Height="700">
    <winuiEx:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winuiEx:WindowEx.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">
        <TitleBar x:Name="AppTitleBar" Title="Добавление торрента"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.LeftHeader>
                <ImageIcon Width="16" Height="16" Margin="15,0,14,0"
                           Source="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid x:Name="Root" Grid.Row="1" Padding="24,16,24,16" Loaded="Root_Loaded"
              RowSpacing="18" RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock Text="Добавить торрент" FontSize="28" FontWeight="SemiBold" />

            <StackPanel Grid.Row="1" Grid.RowSpan="3" Spacing="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LoadCommand.IsRunning, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.LoadCommand.IsRunning, Mode=OneWay}"
                              Width="40" Height="40" AutomationProperties.Name="Получаем список файлов" />
                <TextBlock Text="Получаем список файлов…" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.RowSpan="3" Spacing="16" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
                         Severity="Error" Title="Не удалось подготовить торрент"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Button Content="Повторить" Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="14" ColumnDefinitions="Auto,*"
                  Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                <Image Width="40" Height="40" VerticalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/FileTypes/torrent.svg" />
                    </Image.Source>
                </Image>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="18"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" />
                    <TextBlock Text="{x:Bind ViewModel.Size, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                <TextBlock Text="Папка сохранения" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}"
                             PlaceholderText="Выберите папку…" />
                    <Button Grid.Column="1" Content="Обзор…" Click="PickFolder_Click" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6" MinHeight="0"
                  Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                <TextBlock Text="Содержимое" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Выберите файлы для загрузки"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Grid.Row="2" Margin="0,6,0,0" CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TreeView x:Name="FilesTreeView"
                                      ItemsSource="{x:Bind ViewModel.RootItems, Mode=OneWay}"
                                      Expanding="FilesTreeView_Expanding"
                                      CanDragItems="False" CanReorderItems="False"
                                      AllowDrop="False" SelectionMode="None">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="tree:TorrentTreeItemViewModel">
                                        <TreeViewItem ItemsSource="{x:Bind Children}"
                                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      HorizontalContentAlignment="Stretch">
                                            <TreeViewItem.Content>
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                    <CheckBox IsThreeState="True" MinWidth="2"
                                                              IsEnabled="{x:Bind CanToggle}"
                                                              IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                              Click="FileSelection_Click" />
                                                    <Image Grid.Column="1" Width="24" Height="24">
                                                        <Image.Source>
                                                            <SvgImageSource UriSource="{x:Bind IconUri}" />
                                                        </Image.Source>
                                                    </Image>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Name}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}"
                                                               VerticalAlignment="Center" Margin="8,0"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </TreeViewItem.Content>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                </Border>
                <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Отмена" Click="Cancel_Click" MinWidth="100" />
                <Button Content="Добавить торрент" Click="Ok_Click"
                        IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</winuiEx:WindowEx>
