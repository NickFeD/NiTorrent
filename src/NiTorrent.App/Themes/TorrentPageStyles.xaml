<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TorrentBackgroundBrush" Color="#66101519"/>
            <SolidColorBrush x:Key="TorrentSurfaceBrush" Color="#E8202A31"/>
            <SolidColorBrush x:Key="TorrentSurfaceStrongBrush" Color="#F027333B"/>
            <SolidColorBrush x:Key="TorrentSurfaceHoverBrush" Color="#F0303E47"/>
            <SolidColorBrush x:Key="TorrentSurfaceInsetBrush" Color="#C9141C22"/>
            <SolidColorBrush x:Key="TorrentRowSurfaceBrush" Color="#E827333B"/>
            <SolidColorBrush x:Key="TorrentStrokeBrush" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="TorrentStrokeSoftBrush" Color="#16FFFFFF"/>
            <SolidColorBrush x:Key="TorrentStrokeFocusBrush" Color="#D149A6FF"/>
            <SolidColorBrush x:Key="TorrentTextPrimaryBrush" Color="#F5F8FB"/>
            <SolidColorBrush x:Key="TorrentTextSecondaryBrush" Color="#C7D1D8"/>
            <SolidColorBrush x:Key="TorrentTextTertiaryBrush" Color="#93A3AD"/>
            <SolidColorBrush x:Key="TorrentTextValueBrush" Color="#DCE6EC"/>
            <SolidColorBrush x:Key="TorrentAccentBrush" Color="#4AA2FF"/>
            <SolidColorBrush x:Key="TorrentAccentPressedBrush" Color="#2784E8"/>
            <SolidColorBrush x:Key="TorrentAccentSoftBrush" Color="#264AA2FF"/>
            <SolidColorBrush x:Key="TorrentPurpleBrush" Color="#A98CFF"/>
            <SolidColorBrush x:Key="TorrentPurpleSoftBrush" Color="#2BA98CFF"/>
            <SolidColorBrush x:Key="TorrentGreenBrush" Color="#43D166"/>
            <SolidColorBrush x:Key="TorrentGreenSoftBrush" Color="#2B43D166"/>
            <SolidColorBrush x:Key="TorrentOrangeBrush" Color="#FFAD4D"/>
            <SolidColorBrush x:Key="TorrentOrangeSoftBrush" Color="#2BFFAD4D"/>
            <SolidColorBrush x:Key="TorrentRedBrush" Color="#FF7474"/>
            <SolidColorBrush x:Key="TorrentRedSoftBrush" Color="#2BFF7474"/>
            <SolidColorBrush x:Key="TorrentNeutralStatusBrush" Color="#8C98A1"/>
            <SolidColorBrush x:Key="TorrentNeutralStatusSoftBrush" Color="#2B8C98A1"/>
            <SolidColorBrush x:Key="TorrentProgressTrackBrush" Color="#3C93A3AD"/>

            <AcrylicBrush x:Key="TorrentAcrylicSurfaceBrush"
                          TintColor="#1F2A32"
                          TintOpacity="0.72"
                          TintLuminosityOpacity="0.72"
                          FallbackColor="#EA1F2A32"/>
            <AcrylicBrush x:Key="TorrentAcrylicSupportingBrush"
                          TintColor="#17334A"
                          TintOpacity="0.54"
                          TintLuminosityOpacity="0.64"
                          FallbackColor="#DC172A3A"/>
            <AcrylicBrush x:Key="TorrentAcrylicChromeBrush"
                          TintColor="#111A22"
                          TintOpacity="0.48"
                          TintLuminosityOpacity="0.56"
                          FallbackColor="#D0111A22"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TorrentBackgroundBrush" Color="#66101519"/>
            <SolidColorBrush x:Key="TorrentSurfaceBrush" Color="#E8202A31"/>
            <SolidColorBrush x:Key="TorrentSurfaceStrongBrush" Color="#F027333B"/>
            <SolidColorBrush x:Key="TorrentSurfaceHoverBrush" Color="#F0303E47"/>
            <SolidColorBrush x:Key="TorrentSurfaceInsetBrush" Color="#C9141C22"/>
            <SolidColorBrush x:Key="TorrentRowSurfaceBrush" Color="#E827333B"/>
            <SolidColorBrush x:Key="TorrentStrokeBrush" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="TorrentStrokeSoftBrush" Color="#16FFFFFF"/>
            <SolidColorBrush x:Key="TorrentStrokeFocusBrush" Color="#D149A6FF"/>
            <SolidColorBrush x:Key="TorrentTextPrimaryBrush" Color="#F5F8FB"/>
            <SolidColorBrush x:Key="TorrentTextSecondaryBrush" Color="#C7D1D8"/>
            <SolidColorBrush x:Key="TorrentTextTertiaryBrush" Color="#93A3AD"/>
            <SolidColorBrush x:Key="TorrentTextValueBrush" Color="#DCE6EC"/>
            <SolidColorBrush x:Key="TorrentAccentBrush" Color="#4AA2FF"/>
            <SolidColorBrush x:Key="TorrentAccentPressedBrush" Color="#2784E8"/>
            <SolidColorBrush x:Key="TorrentAccentSoftBrush" Color="#264AA2FF"/>
            <SolidColorBrush x:Key="TorrentPurpleBrush" Color="#A98CFF"/>
            <SolidColorBrush x:Key="TorrentPurpleSoftBrush" Color="#2BA98CFF"/>
            <SolidColorBrush x:Key="TorrentGreenBrush" Color="#43D166"/>
            <SolidColorBrush x:Key="TorrentGreenSoftBrush" Color="#2B43D166"/>
            <SolidColorBrush x:Key="TorrentOrangeBrush" Color="#FFAD4D"/>
            <SolidColorBrush x:Key="TorrentOrangeSoftBrush" Color="#2BFFAD4D"/>
            <SolidColorBrush x:Key="TorrentRedBrush" Color="#FF7474"/>
            <SolidColorBrush x:Key="TorrentRedSoftBrush" Color="#2BFF7474"/>
            <SolidColorBrush x:Key="TorrentNeutralStatusBrush" Color="#8C98A1"/>
            <SolidColorBrush x:Key="TorrentNeutralStatusSoftBrush" Color="#2B8C98A1"/>
            <SolidColorBrush x:Key="TorrentProgressTrackBrush" Color="#3C93A3AD"/>

            <AcrylicBrush x:Key="TorrentAcrylicSurfaceBrush"
                          TintColor="#1F2A32"
                          TintOpacity="0.72"
                          TintLuminosityOpacity="0.72"
                          FallbackColor="#EA1F2A32"/>
            <AcrylicBrush x:Key="TorrentAcrylicSupportingBrush"
                          TintColor="#17334A"
                          TintOpacity="0.54"
                          TintLuminosityOpacity="0.64"
                          FallbackColor="#DC172A3A"/>
            <AcrylicBrush x:Key="TorrentAcrylicChromeBrush"
                          TintColor="#111A22"
                          TintOpacity="0.48"
                          TintLuminosityOpacity="0.56"
                          FallbackColor="#D0111A22"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TorrentBackgroundBrush" Color="#66F5F8FC"/>
            <SolidColorBrush x:Key="TorrentSurfaceBrush" Color="#F7FFFFFF"/>
            <SolidColorBrush x:Key="TorrentSurfaceStrongBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TorrentSurfaceHoverBrush" Color="#FFF2F6FA"/>
            <SolidColorBrush x:Key="TorrentSurfaceInsetBrush" Color="#EAF3F7FA"/>
            <SolidColorBrush x:Key="TorrentRowSurfaceBrush" Color="#F8FFFFFF"/>
            <SolidColorBrush x:Key="TorrentStrokeBrush" Color="#1F000000"/>
            <SolidColorBrush x:Key="TorrentStrokeSoftBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="TorrentStrokeFocusBrush" Color="#B60067C0"/>
            <SolidColorBrush x:Key="TorrentTextPrimaryBrush" Color="#1B1D20"/>
            <SolidColorBrush x:Key="TorrentTextSecondaryBrush" Color="#4E5963"/>
            <SolidColorBrush x:Key="TorrentTextTertiaryBrush" Color="#79838D"/>
            <SolidColorBrush x:Key="TorrentTextValueBrush" Color="#27313A"/>
            <SolidColorBrush x:Key="TorrentAccentBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="TorrentAccentPressedBrush" Color="#005A9E"/>
            <SolidColorBrush x:Key="TorrentAccentSoftBrush" Color="#1C0067C0"/>
            <SolidColorBrush x:Key="TorrentPurpleBrush" Color="#6D45C7"/>
            <SolidColorBrush x:Key="TorrentPurpleSoftBrush" Color="#1E6D45C7"/>
            <SolidColorBrush x:Key="TorrentGreenBrush" Color="#107C41"/>
            <SolidColorBrush x:Key="TorrentGreenSoftBrush" Color="#20107C41"/>
            <SolidColorBrush x:Key="TorrentOrangeBrush" Color="#A45C00"/>
            <SolidColorBrush x:Key="TorrentOrangeSoftBrush" Color="#22A45C00"/>
            <SolidColorBrush x:Key="TorrentRedBrush" Color="#C42B1C"/>
            <SolidColorBrush x:Key="TorrentRedSoftBrush" Color="#22C42B1C"/>
            <SolidColorBrush x:Key="TorrentNeutralStatusBrush" Color="#69737D"/>
            <SolidColorBrush x:Key="TorrentNeutralStatusSoftBrush" Color="#2269737D"/>
            <SolidColorBrush x:Key="TorrentProgressTrackBrush" Color="#22000000"/>

            <AcrylicBrush x:Key="TorrentAcrylicSurfaceBrush"
                          TintColor="#F7FBFF"
                          TintOpacity="0.68"
                          TintLuminosityOpacity="0.78"
                          FallbackColor="#EEF7FBFF"/>
            <AcrylicBrush x:Key="TorrentAcrylicSupportingBrush"
                          TintColor="#EAF5FF"
                          TintOpacity="0.58"
                          TintLuminosityOpacity="0.72"
                          FallbackColor="#E8F1F8FF"/>
            <AcrylicBrush x:Key="TorrentAcrylicChromeBrush"
                          TintColor="#F2F7FC"
                          TintOpacity="0.50"
                          TintLuminosityOpacity="0.66"
                          FallbackColor="#E5F2F7FC"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="TorrentSurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource TorrentAcrylicSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="TorrentCommandBarSurfaceStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{ThemeResource TorrentAcrylicChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentStrokeSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="TorrentCommandButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{ThemeResource TorrentTextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="TorrentPrimaryCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TorrentCommandButtonStyle}">
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="Background" Value="{ThemeResource TorrentAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentStrokeFocusBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="TorrentDangerCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TorrentCommandButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TorrentRedBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentStrokeSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentIconCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TorrentCommandButtonStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="TorrentMetricCardStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="92"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Background" Value="{ThemeResource TorrentAcrylicSupportingBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="TorrentMutedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TorrentTextSecondaryBrush}"/>
    </Style>

    <Style x:Key="TorrentTertiaryTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TorrentTextTertiaryBrush}"/>
    </Style>

    <Style x:Key="TorrentRowContainerStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Background" Value="{ThemeResource TorrentRowSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="TorrentRowSelectedContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentRowContainerStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentStrokeFocusBrush}"/>
    </Style>

    <Style x:Key="TorrentFileIconStyle" TargetType="Border">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{ThemeResource TorrentAccentBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgeBaseStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource TorrentAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentAccentSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgeDownloadingStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentAccentSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgeCheckingStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentPurpleSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentPurpleSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgePausedStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentOrangeSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentOrangeSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgeCompletedStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentGreenSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentGreenSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgeErrorStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentRedSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentRedSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentBadgeNeutralStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentBadgeBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentNeutralStatusSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource TorrentNeutralStatusSoftBrush}"/>
    </Style>

    <Style x:Key="TorrentProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Foreground" Value="{ThemeResource TorrentAccentBrush}"/>
        <Setter Property="Background" Value="{ThemeResource TorrentProgressTrackBrush}"/>
    </Style>

    <Style x:Key="TorrentMenuButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource TorrentIconCommandButtonStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="{ThemeResource TorrentTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="TorrentDetailsPanelStyle"
           TargetType="Border"
           BasedOn="{StaticResource TorrentSurfaceBorderStyle}">
        <Setter Property="Background" Value="{ThemeResource TorrentAcrylicSurfaceBrush}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="TorrentInfoLabelTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TorrentMutedTextBlockStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxLines" Value="1"/>
    </Style>

    <Style x:Key="TorrentInfoValueTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TorrentTextValueBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="MaxLines" Value="1"/>
    </Style>
</ResourceDictionary>
