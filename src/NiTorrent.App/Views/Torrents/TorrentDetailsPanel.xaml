<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NiTorrent.App.Views.Torrents.TorrentDetailsPanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NiTorrent.App.Converters">

    <UserControl.Resources>
        <converters:TorrentStateToBadgeStyleConverter x:Key="TorrentStateToBadgeStyleConverter"/>
    </UserControl.Resources>

    <Border Style="{StaticResource TorrentDetailsPanelStyle}">
        <Grid>
            <Grid x:Name="EmptyState">
                <StackPanel Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="28"
                              Foreground="{StaticResource TorrentTextTertiaryBrush}"/>
                    <TextBlock Text="Выберите торрент"
                               Foreground="{StaticResource TorrentTextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Здесь появится краткая информация и действия."
                               Style="{StaticResource TorrentMutedTextBlockStyle}"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="DetailsContent"
                  RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            CornerRadius="8"
                            Background="{x:Bind Torrent.State, Mode=OneWay, Converter={StaticResource TorrentStateToBadgeStyleConverter}}">
                        <FontIcon Glyph="&#xE7C3;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="18"
                                  Foreground="White"/>
                    </Border>

                    <StackPanel Grid.Column="1" MinWidth="0">
                        <TextBlock Text="{x:Bind Torrent.Name, Mode=OneWay}"
                                   Foreground="{StaticResource TorrentTextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="WrapWholeWords"
                                   MaxLines="2"/>

                        <Border Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Style="{x:Bind Torrent.State, Mode=OneWay, Converter={StaticResource TorrentStateToBadgeStyleConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="{x:Bind Torrent.State, Mode=OneWay, Converter={StaticResource TorrentStateToBadgeStyleConverter}}"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="12"
                                          Foreground="{x:Bind Torrent.State, Mode=OneWay, Converter={StaticResource TorrentStateToBadgeStyleConverter}}"/>
                                <TextBlock Text="{x:Bind Torrent.StateText, Mode=OneWay}"
                                           Foreground="{x:Bind Torrent.State, Mode=OneWay, Converter={StaticResource TorrentStateToBadgeStyleConverter}}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource TorrentMenuButtonStyle}"
                            Command="{x:Bind Torrent.ToggleFavoriteCommand, Mode=OneWay}">
                        <FontIcon Glyph="&#xE735;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="14"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind Torrent.ProgressText, Mode=OneWay}"
                                   Foreground="{StaticResource TorrentTextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Torrent.ProgressSummaryText, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"
                                   TextAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                    </Grid>

                    <ProgressBar Style="{StaticResource TorrentProgressBarStyle}"
                                 Value="{x:Bind Torrent.Progress, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="{x:Bind Torrent.State, Mode=OneWay, Converter={StaticResource TorrentStateToBadgeStyleConverter}}"/>
                </StackPanel>

                <SelectorBar Grid.Row="2">
                    <SelectorBarItem Text="Обзор"/>
                    <SelectorBarItem Text="Файлы"/>
                    <SelectorBarItem Text="Пиры"/>
                    <SelectorBarItem Text="Трекеры"/>
                </SelectorBar>

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Путь" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.SavePath, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Размер" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.SizeDetailsText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Получено" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.DownloadedText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Загрузка" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.DownloadSpeed, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Отдача" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.UploadSpeed, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Пиры" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.PeersText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Трекеры" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.TrackersText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE930;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Состояние" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.StateText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Осталось" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.EtaText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>

                        <Grid ColumnSpacing="16" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Hash" Style="{StaticResource TorrentInfoLabelTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Torrent.HashText, Mode=OneWay}" Style="{StaticResource TorrentInfoValueTextBlockStyle}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="4"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource TorrentStrokeBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Действия"
                                   Foreground="{StaticResource TorrentTextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource TorrentCommandButtonStyle}"
                                    Command="{x:Bind Torrent.StartCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                    <TextBlock Text="Старт"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource TorrentCommandButtonStyle}"
                                    Command="{x:Bind Torrent.PauseCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                    <TextBlock Text="Пауза"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource TorrentDangerCommandButtonStyle}"
                                    Command="{x:Bind Torrent.RemoveCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                    <TextBlock Text="Удалить"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
