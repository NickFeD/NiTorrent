<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NiTorrent.App.Views.Torrents.TorrentDetailsPanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NiTorrent.Presentation.Features.Torrents">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TorrentDetailsSurfaceBrush" Color="#20272E"/>
        <SolidColorBrush x:Key="TorrentDetailsSurfaceSoftBrush" Color="#1B2229"/>
        <SolidColorBrush x:Key="TorrentDetailsStrokeBrush" Color="#33414C"/>
        <SolidColorBrush x:Key="TorrentDetailsStrokeSoftBrush" Color="#26333D"/>
        <SolidColorBrush x:Key="TorrentDetailsMutedTextBrush" Color="#B4C0CB"/>
        <SolidColorBrush x:Key="TorrentDetailsAccentBrush" Color="#4C9AFF"/>
        <SolidColorBrush x:Key="TorrentDetailsDangerBrush" Color="#FF5A5F"/>
        <SolidColorBrush x:Key="TorrentDetailsDangerSoftBrush" Color="#24FF5A5F"/>

        <Style x:Key="TorrentDetailsMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TorrentDetailsMutedTextBrush}"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>

        <Style x:Key="TorrentDetailsMetricTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TorrentDetailsSurfaceSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TorrentDetailsStrokeSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <DataTemplate x:Key="TorrentDetailsContentTemplate"
                      x:DataType="vm:TorrentItemViewModel">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48"
                            Height="48"
                            CornerRadius="10"
                            Background="{StaticResource TorrentDetailsAccentBrush}">
                        <FontIcon Glyph="&#xE8A5;"
                                  FontSize="22"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"/>
                        <TextBlock Text="{x:Bind StateText, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   Style="{StaticResource TorrentDetailsMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Size, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   Style="{StaticResource TorrentDetailsMutedTextStyle}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Height="6"
                                 Value="{x:Bind Progress, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="100"/>
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource TorrentDetailsMetricTileStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74B;" FontSize="12" Opacity="0.72"/>
                                <TextBlock Text="Загрузка" Opacity="0.72"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind DownloadSpeed, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource TorrentDetailsMetricTileStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74A;" FontSize="12" Opacity="0.72"/>
                                <TextBlock Text="Отдача" Opacity="0.72"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind UploadSpeed, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Spacing="14">
                    <TextBlock Text="Сведения"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Размер" Opacity="0.68"/>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Size, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="1" Text="Получено" Opacity="0.68"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="—"/>
                            <TextBlock Text="/"/>
                            <TextBlock Text="{x:Bind Size, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Состояние" Opacity="0.68"/>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{x:Bind StateText, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="3" Text="Загрузка" Opacity="0.68"/>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{x:Bind DownloadSpeed, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="4" Text="Отдача" Opacity="0.68"/>
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="{x:Bind UploadSpeed, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="5" Text="ETA" Opacity="0.68"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="—"/>

                        <TextBlock Grid.Row="6" Text="Пиры" Opacity="0.68"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="—"/>

                        <TextBlock Grid.Row="7" Text="Трекеры" Opacity="0.68"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="—"/>

                        <TextBlock Grid.Row="8" Text="Добавлен" Opacity="0.68"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="—"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Путь сохранения"
                                   Opacity="0.68"/>
                        <TextBlock Text="{x:Bind SavePath, Mode=OneWay, TargetNullValue=—, FallbackValue=—}"
                                   TextWrapping="WrapWholeWords"
                                   Opacity="0.92"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Command="{x:Bind StartCommand, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="15"/>
                            <TextBlock Text="Старт"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{x:Bind PauseCommand, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE769;" FontSize="15"/>
                            <TextBlock Text="Пауза"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{x:Bind RemoveCommand, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Padding="12,8"
                            Foreground="{StaticResource TorrentDetailsDangerBrush}"
                            BorderBrush="{StaticResource TorrentDetailsDangerSoftBrush}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="15"/>
                            <TextBlock Text="Удалить"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Button Grid.Row="5"
                        Margin="0,10,0,0"
                        Command="{x:Bind OpenFolderCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="15"/>
                        <TextBlock Text="Открыть папку"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="20"
            Background="{StaticResource TorrentDetailsSurfaceBrush}"
            BorderBrush="{StaticResource TorrentDetailsStrokeBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid x:Name="EmptyState">
                <StackPanel Spacing="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;"
                              FontSize="28"
                              Opacity="0.58"/>
                    <TextBlock Text="Выберите торрент слева"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Здесь появится информация о выбранном торренте."
                               Style="{StaticResource TorrentDetailsMutedTextStyle}"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="DetailsHost"
                            Content="{Binding Torrent, ElementName=Root}"
                            ContentTemplate="{StaticResource TorrentDetailsContentTemplate}"/>
        </Grid>
    </Border>
</UserControl>
