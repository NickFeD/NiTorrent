<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NiTorrent.App.Views.Torrents.TorrentPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NiTorrent.App.Converters"
    xmlns:views="using:NiTorrent.App.Views.Torrents"
    xmlns:vm="using:NiTorrent.Presentation.Features.Torrents"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <converters:TorrentStateToBadgeStyleConverter x:Key="TorrentStateToBadgeStyleConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="ShowWhenTrueConverter"/>

            <SolidColorBrush x:Key="TorrentPageBackgroundBrush" Color="#151C22"/>
            <SolidColorBrush x:Key="TorrentSurfaceBrush" Color="#20272E"/>
            <SolidColorBrush x:Key="TorrentSurfaceElevatedBrush" Color="#263039"/>
            <SolidColorBrush x:Key="TorrentSurfaceSoftBrush" Color="#1B2229"/>
            <SolidColorBrush x:Key="TorrentStrokeBrush" Color="#33414C"/>
            <SolidColorBrush x:Key="TorrentStrokeSoftBrush" Color="#26333D"/>
            <SolidColorBrush x:Key="TorrentMutedTextBrush" Color="#B4C0CB"/>
            <SolidColorBrush x:Key="TorrentAccentBlueBrush" Color="#4C9AFF"/>
            <SolidColorBrush x:Key="TorrentStatusGreenBrush" Color="#39D66D"/>
            <SolidColorBrush x:Key="TorrentStatusOrangeBrush" Color="#F5A342"/>
            <SolidColorBrush x:Key="TorrentStatusPurpleBrush" Color="#9B7CFF"/>
            <SolidColorBrush x:Key="TorrentDangerBrush" Color="#FF5A5F"/>
            <SolidColorBrush x:Key="TorrentDangerSoftBrush" Color="#24FF5A5F"/>

            <Style x:Key="TorrentPanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TorrentSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TorrentStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>

            <Style x:Key="TorrentSummaryCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TorrentSurfaceElevatedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TorrentStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="TorrentMetricTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TorrentSurfaceSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TorrentStrokeSoftBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="TorrentMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TorrentMutedTextBrush}"/>
                <Setter Property="Opacity" Value="0.82"/>
            </Style>

            <Style x:Key="TorrentSummaryTitleStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="TorrentSummaryValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24"
          RowSpacing="22"
          Background="{StaticResource TorrentPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TeachingTip -->
        <TeachingTip x:Name="MagnetTip"
                     Title="Добавить Magnet ссылку"
                     IsLightDismissEnabled="True"
                     PreferredPlacement="Center"
                     ShouldConstrainToRootBounds="True">
            <StackPanel Spacing="12" Width="320">
                <TextBox x:Name="MagnetInput"
                         PlaceholderText="Вставьте Magnet ссылку…"
                         AcceptsReturn="False"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Отмена" Click="CancelMagnet_Click"/>
                    <Button Content="Добавить" Click="ConfirmMagnet_Click"/>
                </StackPanel>
            </StackPanel>
        </TeachingTip>

        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Торренты"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Opacity="0.78">
                    <TextBlock Text="Всего:"/>
                    <TextBlock Text="{x:Bind ViewModel.Torrents.Count, Mode=OneWay}"/>
                    <TextBlock Text="•"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalDownloadSpeed, Mode=OneWay}"/>
                    <TextBlock Text="•"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalUploadSpeed, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Button MinWidth="132"
                        Padding="16,8"
                        Style="{StaticResource AccentButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Добавить .torrent файл"
                                            Icon="OpenFile"
                                            Command="{x:Bind ViewModel.PickTorrentCommand}"/>
                            <MenuFlyoutItem Text="Добавить Magnet ссылку"
                                            Icon="Link"
                                            Click="AddMagnet_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="108"
                        Padding="14,8"
                        Command="{x:Bind ViewModel.SelectedTorrent.StartCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock Text="Старт"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="108"
                        Padding="14,8"
                        Command="{x:Bind ViewModel.SelectedTorrent.PauseCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="16"/>
                        <TextBlock Text="Пауза"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="108"
                        Padding="14,8"
                        Command="{x:Bind ViewModel.SelectedTorrent.OpenFolderCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                        <TextBlock Text="Папка"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="112"
                        Padding="14,8"
                        Foreground="{StaticResource TorrentDangerBrush}"
                        BorderBrush="{StaticResource TorrentDangerSoftBrush}"
                        IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Удалить"
                                            Icon="Delete"
                                            Command="{x:Bind ViewModel.SelectedTorrent.RemoveCommand, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="Удалить со скачанным"
                                            Icon="Delete"
                                            Command="{x:Bind ViewModel.SelectedTorrent.RemoveWithDataCommand, Mode=OneWay}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource TorrentSummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Активные"
                                   Foreground="{StaticResource TorrentAccentBlueBrush}"
                                   Style="{StaticResource TorrentSummaryTitleStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveTorrentCount, Mode=OneWay}"
                                   Style="{StaticResource TorrentSummaryValueStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalTorrentCountText, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextStyle}"/>
                    </StackPanel>

                    <FontIcon Grid.Column="1"
                              Glyph="&#xE9D9;"
                              FontSize="24"
                              Foreground="{StaticResource TorrentAccentBlueBrush}"
                              Opacity="0.9"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource TorrentSummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="На паузе"
                                   Foreground="{StaticResource TorrentStatusOrangeBrush}"
                                   Style="{StaticResource TorrentSummaryTitleStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PausedTorrentCount, Mode=OneWay}"
                                   Style="{StaticResource TorrentSummaryValueStyle}"/>
                    </StackPanel>

                    <FontIcon Grid.Column="1"
                              Glyph="&#xE769;"
                              FontSize="24"
                              Foreground="{StaticResource TorrentStatusOrangeBrush}"
                              Opacity="0.9"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource TorrentSummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Завершено"
                                   Foreground="{StaticResource TorrentStatusGreenBrush}"
                                   Style="{StaticResource TorrentSummaryTitleStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.CompletedTorrentCount, Mode=OneWay}"
                                   Style="{StaticResource TorrentSummaryValueStyle}"/>
                    </StackPanel>

                    <FontIcon Grid.Column="1"
                              Glyph="&#xE73E;"
                              FontSize="24"
                              Foreground="{StaticResource TorrentStatusGreenBrush}"
                              Opacity="0.9"/>
                </Grid>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource TorrentSummaryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Общая скорость"
                                   Foreground="{StaticResource TorrentStatusPurpleBrush}"
                                   Style="{StaticResource TorrentSummaryTitleStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalDownloadSpeed, Mode=OneWay}"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalUploadSpeed, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextStyle}"/>
                    </StackPanel>

                    <FontIcon Grid.Column="1"
                              Glyph="&#xE9D2;"
                              FontSize="24"
                              Foreground="{StaticResource TorrentStatusPurpleBrush}"
                              Opacity="0.9"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource TorrentPanelBorderStyle}"
                    Padding="0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource TorrentStrokeSoftBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Padding="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Имя"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="Размер"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Состояние"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Opacity="0.76">
                                <FontIcon Glyph="&#xE74B;" FontSize="12"/>
                                <TextBlock Text="Скорость"
                                           Foreground="{StaticResource TorrentMutedTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Opacity="0.76">
                                <FontIcon Glyph="&#xE74A;" FontSize="12"/>
                                <TextBlock Text="Скорость"
                                           Foreground="{StaticResource TorrentMutedTextBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5"
                                       Text="Прогресс"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.Torrents, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTorrent, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionChanged="ListView_SelectionChanged"
                                  DoubleTapped="TorrentList_DoubleTapped">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                                    <views:TorrentCardView Torrent="{Binding}"
                                                           DetailsRequested="TorrentCard_DetailsRequested"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource ShowWhenTrueConverter}}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="28" Opacity="0.70"/>
                                <TextBlock Text="Пока нет торрентов"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Добавьте .torrent файл или magnet-ссылку."
                                           Opacity="0.75"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource TorrentStrokeSoftBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Padding="16,0">
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Opacity="0.72"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource TorrentPanelBorderStyle}"
                    Padding="20">
                <Grid>
                    <Grid Visibility="{x:Bind ViewModel.IsDetailsEmpty, Mode=OneWay}">
                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="28"
                                      Opacity="0.58"/>
                            <TextBlock Text="Выберите торрент слева"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Здесь появится информация о выбранном торренте."
                                       Style="{StaticResource TorrentMutedTextStyle}"
                                       TextAlignment="Center"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </Grid>

                    <Grid RowSpacing="18"
                          Visibility="{x:Bind ViewModel.HasSelectedTorrent, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="10"
                                    Background="{StaticResource TorrentAccentBlueBrush}">
                                <FontIcon Glyph="&#xE8A5;"
                                          FontSize="22"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTorrent.Name, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedTorrent.StateText, Mode=OneWay}"
                                           Opacity="0.76"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind ViewModel.SelectedTorrent.ProgressText, Mode=OneWay}"
                                           FontSize="28"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.SelectedTorrent.Size, Mode=OneWay}"
                                           Opacity="0.78"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ProgressBar Grid.Row="1"
                                         Height="6"
                                         Value="{x:Bind ViewModel.SelectedTorrent.Progress, Mode=OneWay}"
                                         Minimum="0"
                                         Maximum="100"/>
                        </Grid>

                        <Grid Grid.Row="2"
                              ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource TorrentMetricTileStyle}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74B;" FontSize="12" Opacity="0.72"/>
                                        <TextBlock Text="Загрузка" Opacity="0.72"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTorrent.DownloadSpeed, Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource TorrentMetricTileStyle}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74A;" FontSize="12" Opacity="0.72"/>
                                        <TextBlock Text="Отдача" Opacity="0.72"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTorrent.UploadSpeed, Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="3" Spacing="14">
                            <TextBlock Text="Сведения"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Размер" Opacity="0.68"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.SelectedTorrent.Size, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Text="Состояние" Opacity="0.68"/>
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.SelectedTorrent.StateText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="2" Text="Загрузка" Opacity="0.68"/>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.SelectedTorrent.DownloadSpeed, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="3" Text="Отдача" Opacity="0.68"/>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="{x:Bind ViewModel.SelectedTorrent.UploadSpeed, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Путь сохранения"
                                           Opacity="0.68"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedTorrent.SavePath, Mode=OneWay}"
                                           TextWrapping="WrapWholeWords"
                                           Opacity="0.92"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Command="{x:Bind ViewModel.SelectedTorrent.StartCommand, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="15"/>
                                    <TextBlock Text="Старт"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.SelectedTorrent.PauseCommand, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,8">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE769;" FontSize="15"/>
                                    <TextBlock Text="Пауза"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,8"
                                    Foreground="{StaticResource TorrentDangerBrush}"
                                    BorderBrush="{StaticResource TorrentDangerSoftBrush}"
                                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Удалить"
                                                        Icon="Delete"
                                                        Command="{x:Bind ViewModel.SelectedTorrent.RemoveCommand, Mode=OneWay}"/>
                                        <MenuFlyoutItem Text="Удалить со скачанным"
                                                        Icon="Delete"
                                                        Command="{x:Bind ViewModel.SelectedTorrent.RemoveWithDataCommand, Mode=OneWay}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="15"/>
                                    <TextBlock Text="Удалить"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Grid.Row="5"
                                Margin="0,10,0,0"
                                Command="{x:Bind ViewModel.SelectedTorrent.OpenFolderCommand, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15"/>
                                <TextBlock Text="Открыть папку"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
