<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NiTorrent.App.Views.Torrents.TorrentPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NiTorrent.App.Converters"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:NiTorrent.App.Views.Torrents"
    xmlns:vm="using:NiTorrent.Presentation.Features.Torrents"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="ShowWhenTrueConverter"/>

            <Style x:Key="TorrentPageHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TorrentTextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="TorrentTableHeaderTextStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource TorrentMutedTextBlockStyle}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxLines" Value="1"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LayoutRoot"
          Padding="10"
          RowSpacing="0"
          ColumnSpacing="0"
          Background="{ThemeResource TorrentBackgroundBrush}"
          SizeChanged="LayoutRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainContentColumn" Width="*"/>
            <ColumnDefinition x:Name="TorrentDetailsSplitterColumn" Width="10"/>
            <ColumnDefinition x:Name="TorrentDetailsColumn"
                              Width="380"
                              MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="TorrentSummaryRow"
                           Height="92"
                           MinHeight="92"
                           MaxHeight="124"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="TorrentDetailsOuterRow" Height="0"/>
        </Grid.RowDefinitions>

        <TeachingTip x:Name="MagnetTip"
                     Title="Добавить Magnet ссылку"
                     IsLightDismissEnabled="True"
                     PreferredPlacement="Center"
                     ShouldConstrainToRootBounds="True">
            <StackPanel Spacing="12" Width="320">
                <TextBox x:Name="MagnetInput"
                         PlaceholderText="Вставьте Magnet ссылку..."
                         AcceptsReturn="False"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Отмена" Click="CancelMagnet_Click"/>
                    <Button Content="Добавить" Click="ConfirmMagnet_Click"/>
                </StackPanel>
            </StackPanel>
        </TeachingTip>

        <Border Grid.Row="0"
                Style="{StaticResource TorrentSurfaceBorderStyle}"
                MinHeight="66"
                Margin="0,0,0,10"
                Padding="12,10">
            <Grid x:Name="HeaderGrid"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Spacing="3"
                            VerticalAlignment="Center">
                    <TextBlock Text="Торренты"
                               Style="{StaticResource TorrentPageHeaderTextStyle}"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="Всего:"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalTorrentCount, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="•"
                                   Style="{StaticResource TorrentTertiaryTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="Активных:"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveTorrentCount, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="•"
                                   Style="{StaticResource TorrentTertiaryTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalDownloadSpeedDisplay, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="•"
                                   Style="{StaticResource TorrentTertiaryTextBlockStyle}"
                                   FontSize="13"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalUploadSpeedDisplay, Mode=OneWay}"
                                   Style="{StaticResource TorrentMutedTextBlockStyle}"
                                   FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="ToolbarSurface"
                        Grid.Column="1"
                        Style="{StaticResource TorrentCommandBarSurfaceStyle}"
                        VerticalAlignment="Center">
                    <Grid>
                    <CommandBar DefaultLabelPosition="Right"
                                ClosedDisplayMode="Compact"
                                IsDynamicOverflowEnabled="True"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="0"
                                MinHeight="40">
                        <AppBarButton Label="Добавить">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Добавить .torrent файл"
                                                    Icon="OpenFile"
                                                    Command="{x:Bind ViewModel.PickTorrentCommand}"/>
                                    <MenuFlyoutItem Text="Добавить Magnet ссылку"
                                                    Icon="Link"
                                                    Click="AddMagnet_Click"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarSeparator/>

                        <AppBarButton Label="Старт"
                                      Command="{x:Bind ViewModel.SelectedTorrent.StartCommand, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Пауза"
                                      Command="{x:Bind ViewModel.SelectedTorrent.PauseCommand, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE769;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Папка"
                                      Command="{x:Bind ViewModel.SelectedTorrent.OpenFolderCommand, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Удалить"
                                      IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Удалить"
                                                    Icon="Delete"
                                                    Command="{x:Bind ViewModel.SelectedTorrent.RemoveCommand, Mode=OneWay}"/>
                                    <MenuFlyoutItem Text="Удалить со скачанным"
                                                    Icon="Delete"
                                                    Command="{x:Bind ViewModel.SelectedTorrent.RemoveWithDataCommand, Mode=OneWay}"/>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="ToolbarPanel"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <Button Style="{StaticResource TorrentPrimaryCommandButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Добавить .torrent файл"
                                                        Icon="OpenFile"
                                                        Command="{x:Bind ViewModel.PickTorrentCommand}"/>
                                        <MenuFlyoutItem Text="Добавить Magnet ссылку"
                                                        Icon="Link"
                                                        Click="AddMagnet_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="14"/>
                                    <TextBlock Text="Добавить"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource TorrentCommandButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectedTorrent.StartCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="14"/>
                                    <TextBlock Text="Старт"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource TorrentCommandButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectedTorrent.PauseCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE769;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="14"/>
                                    <TextBlock Text="Пауза"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource TorrentCommandButtonStyle}"
                                    Command="{x:Bind ViewModel.SelectedTorrent.OpenFolderCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="14"/>
                                    <TextBlock Text="Папка"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource TorrentDangerCommandButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Удалить"
                                                        Icon="Delete"
                                                        Command="{x:Bind ViewModel.SelectedTorrent.RemoveCommand, Mode=OneWay}"/>
                                        <MenuFlyoutItem Text="Удалить со скачанным"
                                                        Icon="Delete"
                                                        Command="{x:Bind ViewModel.SelectedTorrent.RemoveWithDataCommand, Mode=OneWay}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="14"/>
                                    <TextBlock Text="Удалить"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource TorrentIconCommandButtonStyle}">
                                <FontIcon Glyph="&#xE734;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="SummaryGrid"
              Grid.Row="1"
              ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="SummaryCardsSecondRow" Height="0"/>
                <RowDefinition x:Name="SummaryCardsThirdRow" Height="0"/>
                <RowDefinition x:Name="SummaryCardsFourthRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SummaryColumn0" Width="*"/>
                <ColumnDefinition x:Name="SummaryColumn1" Width="*"/>
                <ColumnDefinition x:Name="SummaryColumn2" Width="*"/>
                <ColumnDefinition x:Name="SummaryColumn3" Width="*"/>
            </Grid.ColumnDefinitions>

            <views:TorrentSummaryCard x:Name="ActiveSummaryCard"
                                      Title="Активные"
                                      Value="{x:Bind ViewModel.ActiveTorrentCount, Mode=OneWay}"
                                      Subtitle="{x:Bind ViewModel.TotalSpeedSubtitleDisplay, Mode=OneWay}"
                                      IconGlyph="&#xE9D9;"
                                      AccentBrush="{ThemeResource TorrentAccentBrush}"/>

            <views:TorrentSummaryCard x:Name="PausedSummaryCard"
                                      Grid.Column="1"
                                      Title="На паузе"
                                      Value="{x:Bind ViewModel.PausedTorrentCount, Mode=OneWay}"
                                      Subtitle="0 B/s"
                                      IconGlyph="&#xE769;"
                                      AccentBrush="{ThemeResource TorrentOrangeBrush}"/>

            <views:TorrentSummaryCard x:Name="CompletedSummaryCard"
                                      Grid.Column="2"
                                      Title="Завершено"
                                      Value="{x:Bind ViewModel.CompletedTorrentCount, Mode=OneWay}"
                                      Subtitle="{x:Bind ViewModel.TotalTorrentCountText, Mode=OneWay}"
                                      IconGlyph="&#xE73E;"
                                      AccentBrush="{ThemeResource TorrentGreenBrush}"/>

            <views:TorrentSummaryCard x:Name="SpeedSummaryCard"
                                      Grid.Column="3"
                                      Title="Общая скорость"
                                      Value="{x:Bind ViewModel.TotalSpeedDisplay, Mode=OneWay}"
                                      Subtitle="{x:Bind ViewModel.TotalSpeedSubtitleDisplay, Mode=OneWay}"
                                      IconGlyph="&#xE9D2;"
                                      AccentBrush="{ThemeResource TorrentPurpleBrush}"/>
        </Grid>

        <primitives:Thumb Grid.Row="2"
                          x:Name="TorrentSummarySplitter"
                          Height="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          PointerEntered="TorrentSummarySplitter_PointerEntered"
                          PointerExited="TorrentSummarySplitter_PointerExited"
                          DragDelta="TorrentSummarySplitter_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Border Height="2"
                                VerticalAlignment="Center"
                                Margin="12,0"
                                CornerRadius="1"
                                Background="{ThemeResource TorrentStrokeBrush}"
                                Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

        <Grid x:Name="TorrentContentGrid"
              Grid.Row="3"
              Grid.Column="0"
              ColumnSpacing="0"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TorrentListRow" Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TorrentListColumn"
                                  Width="*"
                                  MinWidth="560"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TorrentListPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource TorrentSurfaceBorderStyle}"
                    Background="{ThemeResource TorrentSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TorrentListHeaderRow" Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="TorrentListHeader"
                            Grid.Row="0"
                            Background="{ThemeResource TorrentSurfaceInsetBrush}"
                            BorderBrush="{ThemeResource TorrentStrokeBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Padding="7,0"
                              ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="HeaderSizeColumn" Width="80"/>
                                <ColumnDefinition x:Name="HeaderStateColumn" Width="102"/>
                                <ColumnDefinition x:Name="HeaderDownloadColumn" Width="96"/>
                                <ColumnDefinition x:Name="HeaderUploadColumn" Width="96"/>
                                <ColumnDefinition x:Name="HeaderProgressColumn" Width="102"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Text="Имя"
                                           Style="{StaticResource TorrentTableHeaderTextStyle}"/>
                            </Grid>
                            <TextBlock x:Name="HeaderSizeText"
                                       Grid.Column="1"
                                       Text="Размер"
                                       Style="{StaticResource TorrentTableHeaderTextStyle}"/>
                            <TextBlock x:Name="HeaderStateText"
                                       Grid.Column="2"
                                       Text="Состояние"
                                       Style="{StaticResource TorrentTableHeaderTextStyle}"/>
                            <StackPanel x:Name="HeaderDownloadPanel"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74B;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="12"
                                          Foreground="{ThemeResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Скорость"
                                           Style="{StaticResource TorrentTableHeaderTextStyle}"/>
                            </StackPanel>
                            <StackPanel x:Name="HeaderUploadPanel"
                                        Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74A;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="12"
                                          Foreground="{ThemeResource TorrentTextSecondaryBrush}"/>
                                <TextBlock Text="Скорость"
                                           Style="{StaticResource TorrentTableHeaderTextStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="HeaderProgressText"
                                       Grid.Column="5"
                                       Text="Прогресс"
                                       Style="{StaticResource TorrentTableHeaderTextStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView x:Name="TorrentListView"
                                  ItemsSource="{x:Bind ViewModel.Torrents, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTorrent, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="5"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionChanged="ListView_SelectionChanged"
                                  DoubleTapped="TorrentList_DoubleTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                                    <views:TorrentItemView DetailsRequested="TorrentCard_DetailsRequested"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource ShowWhenTrueConverter}}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="28"
                                          Foreground="{ThemeResource TorrentTextTertiaryBrush}"/>
                                <TextBlock Text="Пока нет торрентов"
                                           Foreground="{ThemeResource TorrentTextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Добавьте .torrent файл или magnet-ссылку."
                                           Style="{StaticResource TorrentMutedTextBlockStyle}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{ThemeResource TorrentSurfaceInsetBrush}"
                            BorderBrush="{ThemeResource TorrentStrokeSoftBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Padding="12,0"
                              ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind ViewModel.TotalTorrentCountText, Mode=OneWay}"
                                       Style="{StaticResource TorrentMutedTextBlockStyle}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       Style="{StaticResource TorrentTertiaryTextBlockStyle}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <primitives:Thumb Grid.Row="0"
                          Grid.RowSpan="4"
                          Grid.Column="1"
                          x:Name="TorrentDetailsSplitter"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          PointerEntered="TorrentDetailsSplitter_PointerEntered"
                          PointerExited="TorrentDetailsSplitter_PointerExited"
                          DragDelta="TorrentDetailsSplitter_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Border Width="2"
                                HorizontalAlignment="Center"
                                Margin="0,12"
                                CornerRadius="1"
                                Background="{ThemeResource TorrentStrokeBrush}"
                                Opacity="0"/>
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

        <views:TorrentDetailsPanel x:Name="TorrentDetailsPanel"
                                   Grid.Row="0"
                                   Grid.RowSpan="4"
                                   Grid.Column="2"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Torrent="{x:Bind ViewModel.SelectedTorrent, Mode=OneWay}"/>
    </Grid>
</Page>
