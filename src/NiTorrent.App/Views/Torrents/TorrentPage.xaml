<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NiTorrent.App.Views.Torrents.TorrentPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NiTorrent.App.Converters"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:NiTorrent.App.Views.Torrents"
    xmlns:vm="using:NiTorrent.Presentation.Features.Torrents"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <converters:TorrentStateToBadgeStyleConverter x:Key="TorrentStateToBadgeStyleConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="ShowWhenTrueConverter"/>

            <SolidColorBrush x:Key="TorrentPageBackgroundBrush" Color="#151C22"/>
            <SolidColorBrush x:Key="TorrentSurfaceBrush" Color="#20272E"/>
            <SolidColorBrush x:Key="TorrentSurfaceElevatedBrush" Color="#263039"/>
            <SolidColorBrush x:Key="TorrentSurfaceSoftBrush" Color="#1B2229"/>
            <SolidColorBrush x:Key="TorrentStrokeBrush" Color="#33414C"/>
            <SolidColorBrush x:Key="TorrentStrokeSoftBrush" Color="#26333D"/>
            <SolidColorBrush x:Key="TorrentMutedTextBrush" Color="#B4C0CB"/>
            <SolidColorBrush x:Key="TorrentAccentBlueBrush" Color="#4C9AFF"/>
            <SolidColorBrush x:Key="TorrentStatusGreenBrush" Color="#39D66D"/>
            <SolidColorBrush x:Key="TorrentStatusOrangeBrush" Color="#F5A342"/>
            <SolidColorBrush x:Key="TorrentStatusPurpleBrush" Color="#9B7CFF"/>
            <SolidColorBrush x:Key="TorrentDangerBrush" Color="#FF5A5F"/>
            <SolidColorBrush x:Key="TorrentDangerSoftBrush" Color="#24FF5A5F"/>

            <Style x:Key="TorrentPanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TorrentSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TorrentStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>

            <Style x:Key="TorrentMetricTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TorrentSurfaceSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TorrentStrokeSoftBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="TorrentMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TorrentMutedTextBrush}"/>
                <Setter Property="Opacity" Value="0.82"/>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LayoutRoot"
          Padding="24"
          RowSpacing="14"
          Background="{StaticResource TorrentPageBackgroundBrush}"
          SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="TorrentSummaryRow"
                           Height="134"
                           MinHeight="118"
                           MaxHeight="168"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TeachingTip -->
        <TeachingTip x:Name="MagnetTip"
                     Title="Добавить Magnet ссылку"
                     IsLightDismissEnabled="True"
                     PreferredPlacement="Center"
                     ShouldConstrainToRootBounds="True">
            <StackPanel Spacing="12" Width="320">
                <TextBox x:Name="MagnetInput"
                         PlaceholderText="Вставьте Magnet ссылку…"
                         AcceptsReturn="False"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Отмена" Click="CancelMagnet_Click"/>
                    <Button Content="Добавить" Click="ConfirmMagnet_Click"/>
                </StackPanel>
            </StackPanel>
        </TeachingTip>

        <Grid x:Name="HeaderGrid"
              Grid.Row="0"
              ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Торренты"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Opacity="0.78">
                    <TextBlock Text="Всего:"/>
                    <TextBlock Text="{x:Bind ViewModel.Torrents.Count, Mode=OneWay}"/>
                    <TextBlock Text="•"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalDownloadSpeedDisplay, Mode=OneWay}"/>
                    <TextBlock Text="•"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalUploadSpeedDisplay, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ToolbarPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Button MinWidth="132"
                        Padding="16,8"
                        Style="{StaticResource AccentButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Добавить .torrent файл"
                                            Icon="OpenFile"
                                            Command="{x:Bind ViewModel.PickTorrentCommand}"/>
                            <MenuFlyoutItem Text="Добавить Magnet ссылку"
                                            Icon="Link"
                                            Click="AddMagnet_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="108"
                        Padding="14,8"
                        Command="{x:Bind ViewModel.SelectedTorrent.StartCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock Text="Старт"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="108"
                        Padding="14,8"
                        Command="{x:Bind ViewModel.SelectedTorrent.PauseCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="16"/>
                        <TextBlock Text="Пауза"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="108"
                        Padding="14,8"
                        Command="{x:Bind ViewModel.SelectedTorrent.OpenFolderCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                        <TextBlock Text="Папка"/>
                    </StackPanel>
                </Button>

                <Button MinWidth="112"
                        Padding="14,8"
                        Foreground="{StaticResource TorrentDangerBrush}"
                        BorderBrush="{StaticResource TorrentDangerSoftBrush}"
                        IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Удалить"
                                            Icon="Delete"
                                            Command="{x:Bind ViewModel.SelectedTorrent.RemoveCommand, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="Удалить со скачанным"
                                            Icon="Delete"
                                            Command="{x:Bind ViewModel.SelectedTorrent.RemoveWithDataCommand, Mode=OneWay}"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="SummaryGrid"
              Grid.Row="1"
              ColumnSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="SummaryCardsSecondRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SummaryColumn0" Width="*"/>
                <ColumnDefinition x:Name="SummaryColumn1" Width="*"/>
                <ColumnDefinition x:Name="SummaryColumn2" Width="*"/>
                <ColumnDefinition x:Name="SummaryColumn3" Width="*"/>
            </Grid.ColumnDefinitions>

            <views:TorrentSummaryCard x:Name="ActiveSummaryCard"
                                      Title="Активные"
                                      Value="{x:Bind ViewModel.ActiveTorrentCount, Mode=OneWay}"
                                      Subtitle="{x:Bind ViewModel.TotalTorrentCountText, Mode=OneWay}"
                                      IconGlyph="&#xE9D9;"
                                      AccentBrush="{StaticResource TorrentAccentBlueBrush}"/>

            <views:TorrentSummaryCard x:Name="PausedSummaryCard"
                                      Grid.Column="1"
                                      Title="На паузе"
                                      Value="{x:Bind ViewModel.PausedTorrentCount, Mode=OneWay}"
                                      IconGlyph="&#xE769;"
                                      AccentBrush="{StaticResource TorrentStatusOrangeBrush}"/>

            <views:TorrentSummaryCard x:Name="CompletedSummaryCard"
                                      Grid.Column="2"
                                      Title="Завершено"
                                      Value="{x:Bind ViewModel.CompletedTorrentCount, Mode=OneWay}"
                                      IconGlyph="&#xE73E;"
                                      AccentBrush="{StaticResource TorrentStatusGreenBrush}"/>

            <views:TorrentSummaryCard x:Name="SpeedSummaryCard"
                                      Grid.Column="3"
                                      Title="Общая скорость"
                                      Value="{x:Bind ViewModel.TotalSpeedDisplay, Mode=OneWay}"
                                      Subtitle="{x:Bind ViewModel.TotalSpeedSubtitleDisplay, Mode=OneWay}"
                                      IconGlyph="&#xE9D2;"
                                      AccentBrush="{StaticResource TorrentStatusPurpleBrush}"/>
        </Grid>

        <primitives:Thumb Grid.Row="2"
                          x:Name="TorrentSummarySplitter"
                          Height="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DragDelta="TorrentSummarySplitter_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Border Height="2"
                                VerticalAlignment="Center"
                                Margin="12,0"
                                CornerRadius="1"
                                Background="{StaticResource TorrentStrokeBrush}"
                                Opacity="0.45"/>
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

        <Grid x:Name="TorrentContentGrid"
              Grid.Row="3"
              ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TorrentListColumn"
                                  Width="*"
                                  MinWidth="560"/>
                <ColumnDefinition x:Name="TorrentDetailsSplitterColumn" Width="12"/>
                <ColumnDefinition x:Name="TorrentDetailsColumn"
                                  Width="420"
                                  MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TorrentListPanel"
                    Grid.Column="0"
                    Style="{StaticResource TorrentPanelBorderStyle}"
                    Margin="0,0,8,0"
                    Padding="0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource TorrentStrokeSoftBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Padding="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="2"
                                           Text="Имя"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TorrentMutedTextStyle}"/>
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Text="Размер"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="Состояние"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Opacity="0.76">
                                <FontIcon Glyph="&#xE74B;" FontSize="12"/>
                                <TextBlock Text="Скорость"
                                           Foreground="{StaticResource TorrentMutedTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                        Opacity="0.76">
                                <FontIcon Glyph="&#xE74A;" FontSize="12"/>
                                <TextBlock Text="Скорость"
                                           Foreground="{StaticResource TorrentMutedTextBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5"
                                       Text="Прогресс"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TorrentMutedTextStyle}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{x:Bind ViewModel.Torrents, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTorrent, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionChanged="ListView_SelectionChanged"
                                  DoubleTapped="TorrentList_DoubleTapped">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                                    <views:TorrentCardView Torrent="{Binding}"
                                                           DetailsRequested="TorrentCard_DetailsRequested"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource ShowWhenTrueConverter}}">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="28" Opacity="0.70"/>
                                <TextBlock Text="Пока нет торрентов"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Добавьте .torrent файл или magnet-ссылку."
                                           Opacity="0.75"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource TorrentStrokeSoftBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid Padding="16,0">
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Opacity="0.72"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <primitives:Thumb Grid.Column="1"
                              x:Name="TorrentDetailsSplitter"
                              Width="12"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              DragDelta="TorrentDetailsSplitter_DragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Border Width="2"
                                    HorizontalAlignment="Center"
                                    Margin="0,12"
                                    CornerRadius="1"
                                    Background="{StaticResource TorrentStrokeBrush}"
                                    Opacity="0.75"/>
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>

            <views:TorrentDetailsPanel x:Name="TorrentDetailsPanel"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Torrent="{x:Bind ViewModel.SelectedTorrent, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Page>
