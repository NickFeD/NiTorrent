<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NiTorrent.App.Views.Torrents.TorrentSummaryCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TorrentSummarySurfaceBrush" Color="#263039"/>
        <SolidColorBrush x:Key="TorrentSummaryStrokeBrush" Color="#33414C"/>
        <SolidColorBrush x:Key="TorrentSummaryMutedTextBrush" Color="#B4C0CB"/>

        <Style x:Key="TorrentSummaryMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TorrentSummaryMutedTextBrush}"/>
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
    </UserControl.Resources>

    <Border MinHeight="104"
            Padding="14"
            Background="{StaticResource TorrentSummarySurfaceBrush}"
            BorderBrush="{StaticResource TorrentSummaryStrokeBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Foreground="{Binding AccentBrush, ElementName=Root}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <TextBlock Text="{Binding Value, ElementName=Root}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource TorrentSummaryMutedTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </StackPanel>

            <FontIcon Grid.Column="1"
                      Glyph="{Binding IconGlyph, ElementName=Root}"
                      FontSize="24"
                      Foreground="{Binding AccentBrush, ElementName=Root}"
                      Opacity="0.9"
                      VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
