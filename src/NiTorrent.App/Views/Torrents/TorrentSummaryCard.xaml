<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NiTorrent.App.Views.Torrents.TorrentSummaryCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource TorrentMetricCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                           FontSize="13"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>

                <FontIcon Grid.Column="1"
                          Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="16"
                          Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                          Opacity="0.95"/>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,6,0,0"
                       Text="{x:Bind Value, Mode=OneWay}"
                       Foreground="{StaticResource TorrentTextPrimaryBrush}"
                       FontSize="22"
                       FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>

            <TextBlock Grid.Row="2"
                       Margin="0,7,0,0"
                       Text="{x:Bind Subtitle, Mode=OneWay}"
                       Style="{StaticResource TorrentMutedTextBlockStyle}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"/>
        </Grid>
    </Border>
</UserControl>
