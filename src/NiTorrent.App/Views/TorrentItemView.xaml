<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NiTorrent.App.Views.TorrentItemView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI">

    <Border CornerRadius="12"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            RightTapped="TorrentItem_RightTapped">
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="&#x0421;&#x0442;&#x0430;&#x0440;&#x0442;"
                                Icon="Play"
                                Command="{x:Bind Torrent.StartCommand, Mode=OneWay}"/>
                <MenuFlyoutItem Text="&#x041F;&#x0430;&#x0443;&#x0437;&#x0430;"
                                Icon="Pause"
                                Command="{x:Bind Torrent.PauseCommand, Mode=OneWay}"/>
                <MenuFlyoutItem Text="&#x041F;&#x0430;&#x043F;&#x043A;&#x0430;"
                                Icon="Folder"
                                Command="{x:Bind Torrent.OpenFolderCommand, Mode=OneWay}"/>
                <MenuFlyoutItem Text="&#x041F;&#x043E;&#x0434;&#x0440;&#x043E;&#x0431;&#x043D;&#x0435;&#x0435;"
                                Icon="PreviewLink"
                                Click="TorrentDetails_Click"/>
                <MenuFlyoutSubItem Text="&#x0423;&#x0434;&#x0430;&#x043B;&#x0438;&#x0442;&#x044C;"
                                   Icon="Delete">
                    <MenuFlyoutItem Text="&#x0423;&#x0434;&#x0430;&#x043B;&#x0438;&#x0442;&#x044C;"
                                    Icon="Delete"
                                    Command="{x:Bind Torrent.RemoveCommand, Mode=OneWay}"/>
                    <MenuFlyoutItem Text="&#x0423;&#x0434;&#x0430;&#x043B;&#x0438;&#x0442;&#x044C; &#x0441;&#x043E; &#x0441;&#x043A;&#x0430;&#x0447;&#x0430;&#x043D;&#x043D;&#x044B;&#x043C;"
                                    Icon="Delete"
                                    Command="{x:Bind Torrent.RemoveWithDataCommand, Mode=OneWay}"/>
                </MenuFlyoutSubItem>
            </MenuFlyout>
        </Border.ContextFlyout>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind Torrent.Name, Mode=OneWay}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>

                <TextBlock Grid.Column="1"
                           Text="{x:Bind Torrent.Size, Mode=OneWay}"
                           FontSize="12"
                           Opacity="0.75"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind Torrent.StateText, Mode=OneWay}"
                           FontSize="12"
                           Opacity="0.85"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74B;" FontSize="12" Opacity="0.85"/>
                    <TextBlock Text="{x:Bind Torrent.DownloadSpeed, Mode=OneWay}"
                               FontSize="12"
                               Opacity="0.90"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74A;" FontSize="12" Opacity="0.85"/>
                    <TextBlock Text="{x:Bind Torrent.UploadSpeed, Mode=OneWay}"
                               FontSize="12"
                               Opacity="0.90"/>
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="{x:Bind Torrent.ProgressText, Mode=OneWay}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0.95"
                           VerticalAlignment="Center"/>
            </Grid>

            <dev:StorageBar Grid.Row="2"
                            Value="{x:Bind Torrent.Progress, Mode=OneWay}"
                            Minimum="0"
                            Maximum="100"/>
        </Grid>
    </Border>
</UserControl>
